{
  "name": "desktop-pet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "web:dev": "vite web",
    "web:build": "vite build web --outDir ../dist-web --emptyOutDir",
    "backend:dev": "npm --prefix services/backend run dev",
    "backend:build:generator": "npm --prefix services/backend run build:generator",
    "petpack:dev": "cargo run --manifest-path src-tauri/Cargo.toml --bin generate_petpack --"
  },
  "dependencies": {
    "@choochmeque/tauri-plugin-google-auth-api": "^0.5.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
